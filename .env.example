# Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Neo4j ---
# The Neo4j image only accepts "neo4j" as the initial admin user.
NEO4J_USER=neo4j
# At least 8 characters (Neo4j 5 rejects shorter passwords on first start).
NEO4J_PASSWORD=change-me-please
# Host runs use localhost; the app container overrides this to bolt://neo4j:7687.
NEO4J_URI=bolt://localhost:7687
# Seconds the CLI keeps retrying while Neo4j starts up.
NEO4J_CONNECT_TIMEOUT=60
# Neo4j memory (keep small for laptops).
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m

# --- Repository folder(s) mounted read-only at /repos in the app container ---
# Point this at a PARENT folder (e.g. D:/Projects) to connect any project under it from the UI.
# Windows host: see README "Windows bind mounts" for the working path form.
REPO_PATH=./

# --- LLM for text-to-Cypher (the web UI) ---
# openai (default) or openrouter (OpenAI-compatible API, many models).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Only the key for the selected provider is required.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional override of the OpenRouter endpoint.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Query limits for generated / edited Cypher ---
NLQ_MAX_ROWS=200
NLQ_TIMEOUT_SECONDS=15
NLQ_MAX_REPAIRS=2
# Optional: also append the JSON-lines query audit log to this file (always on stderr).
# NLQ_AUDIT_LOG=.codegraph/audit.log

# --- Voice input: local Whisper via faster-whisper (no API key, audio never leaves the machine) ---
# Model sizes: tiny, base, small (default, ~500MB download on first use), medium, large-v3.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Connecting repositories from the UI ---
# Set in the container to /repos (the read-only REPO_PATH mount). Leave unset on the host: any path works.
# CODEGRAPH_REPOS_ROOT=/repos
# Where public Git URLs are shallow-cloned (host default; the container uses the /workspace volume).
CODEGRAPH_WORKSPACE=.codegraph/clones
CODEGRAPH_CLONE_TIMEOUT_SECONDS=180
